programa {
  funcao inicio() {

    inteiro matriz [2][3] = {
      //0//1//2
      {10,20,30},//0
      {40,50,60} //1
    }

    escreva("Elemento da linha 0 coluna 1: ", matriz [0][1],"\n") // como acessar determinado número na matriz
    escreva("Elemento da linha 1 coluna 2: ", matriz [1][2])
    
  }
}
